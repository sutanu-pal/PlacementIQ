# ─────────────────────────────────────────────────────────────
# PlacementIQ — Environment Variables Template
# Copy this to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# ── Database ──
DATABASE_URL=postgresql+asyncpg://placementiq:placementiq@localhost:5432/placementiq
# For local dev without Docker, you can use SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./placementiq.db

# ── JWT Auth ──
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_REFRESH_SECRET_KEY=change-me-to-a-different-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Gemini API ──
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# ── Application ──
APP_NAME=PlacementIQ
APP_ENV=development
DEBUG=true
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# ── File Uploads ──
MAX_UPLOAD_SIZE_MB=5
UPLOAD_DIR=./uploads

# ── Sentence Transformers ──
EMBEDDING_MODEL=all-MiniLM-L6-v2
MODELS_CACHE_DIR=./models_cache
